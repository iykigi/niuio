APP_NAME=Portway
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# --- Database ---------------------------------------------------------
# Portway ships configured for MySQL/MariaDB in production. For a quick
# local trial you can switch DB_CONNECTION=sqlite and remove the other
# DB_* lines — Portway will create database/database.sqlite on demand.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=portway
DB_USERNAME=portway
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
# Session cookies are marked Secure by default, which is correct over HTTPS
# but means you can never stay logged in over plain http://localhost. Set
# this to false for local development only.
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="no-reply@portway.test"
MAIL_FROM_NAME="${APP_NAME}"

REVERB_APP_ID=portway
REVERB_APP_KEY=portwaykey
REVERB_APP_SECRET=portwaysecret
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http

# --- Portway platform configuration -----------------------------------
# Provisioning driver: "local" (safe, filesystem-backed, works out of the
# box for evaluation/dev) or "ssh" (talks to real Linux hosting nodes over
# SSH — see app/Services/Provisioning/Drivers/SshProvisionerDriver.php).
PORTWAY_PROVISIONER=local

# Default per-account storage quota, in megabytes. 10240 = 10 GB.
PORTWAY_DEFAULT_STORAGE_QUOTA_MB=10240

# Whether backups count toward the storage quota.
PORTWAY_BACKUPS_COUNT_TOWARD_QUOTA=false

# The public IPv4 address hosting nodes should tell users to point A
# records at. Used to render DNS instructions in the domain wizard.
PORTWAY_SERVER_IP=203.0.113.10

# ACME / Let's Encrypt account email used by the SSL driver.
PORTWAY_ACME_EMAIL=ssl@portway.test
PORTWAY_ACME_DIRECTORY=https://acme-v02.api.letsencrypt.org/directory
PORTWAY_ACME_STAGING=true

# Email hosting module toggle (off until a mail server is provisioned).
PORTWAY_EMAIL_HOSTING_ENABLED=false

# --- App distribution -------------------------------------------------
# Users can publish desktop builds (Windows/macOS/Linux). Exactly one
# build per platform is live at a time; a platform with nothing published
# is hidden from the public download page entirely.
PORTWAY_APP_DISTRIBUTION_ENABLED=true
PORTWAY_MAX_RELEASE_SIZE_MB=2048
PORTWAY_MAX_RELEASES_PER_APPLICATION=50
PORTWAY_MAX_APPLICATIONS_PER_USER=10
# Where uploaded installers live. Keep this OUTSIDE your web root — the
# panel streams downloads through a controller, it never serves the files
# directly, so nothing here should be reachable by URL.
# PORTWAY_RELEASES_ROOT=/var/lib/portway/releases

# PHP's own upload limits cap release uploads regardless of the values
# above. For 2 GB builds set these in php.ini:
#   upload_max_filesize = 2048M
#   post_max_size       = 2048M
#   max_execution_time  = 600

# The Super Admin account created by `php artisan db:seed`. Change the
# password before deploying anywhere other than your own machine.
PORTWAY_SUPER_ADMIN_EMAIL=admin@portway.test
PORTWAY_SUPER_ADMIN_PASSWORD=password

GOOGLE2FA_APP_NAME="${APP_NAME}"
